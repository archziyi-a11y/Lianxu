                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "operator": {
                          "enum": [
                            "interval_compare",
                            "training_weight",
                            "scene_compare"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "eligibility": {
                          "properties": {
                            "minPoints": {
                              "minimum": 8
                            },
                            "minDays": {
                              "minimum": 14
                            },
                            "minPerGroup": {
                              "minimum": 4
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "guide": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              }
            }
          }
        }
      }
    }
  ]
}