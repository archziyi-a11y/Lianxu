                        "maximum": 1
                      }
                    }
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rollingDays": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 90
                      }
                    }
                  },
                  "refresh": {
                    "const": "on_effective_change"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "operator": {
                          "enum": [
                            "series",
                            "rolling_mean"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
