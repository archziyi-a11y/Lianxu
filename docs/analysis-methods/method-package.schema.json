{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "练序外部分析方法包 v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "manifest",
        "guide"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "title",
            "category",
            "question",
            "operator",
            "windows",
            "eligibility",
            "parameters",
            "refresh"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^user\\.[a-z0-9_.-]+$",
              "maxLength": 80
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "category": {
              "enum": [
                "身体",
                "训练",
                "营养",
                "阶段",
                "发现"
              ]
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "operator": {
              "enum": [
                "series",
                "rolling_mean",
                "calendar",
                "distribution",
                "exercise_progress",
                "interval_compare",
                "phase_compare",
                "training_weight",
                "intake_summary",
                "nutrition_history",
                "phase_summary",
                "scene_compare"
              ]
            },
            "metric": {
              "enum": [
                "weight",
                "body_fat",
                "waist",
                "height"
              ]
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "accumulated",
                  "current_phase",
                  "7d",
                  "28d",
                  "90d"
                ]
              }
            },
            "eligibility": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minPoints",
                "minDays"
              ],
              "properties": {
                "minPoints": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "minDays": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3650
                },
                "minPerGroup": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 1000
                },
                "minEffect": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rollingDays": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 90
                }
              }
            },
            "refresh": {
              "const": "on_effective_change"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "series",
                      "rolling_mean"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "metric"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "interval_compare",
                      "training_weight",
                      "scene_compare"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "eligibility": {
                    "properties": {
                      "minPoints": {
                        "minimum": 8
                      },
                      "minDays": {
                        "minimum": 14
                      },
                      "minPerGroup": {
                        "minimum": 4
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "guide": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packages"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "manifest",
              "guide"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "manifest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version",
                  "title",
                  "category",
                  "question",
                  "operator",
                  "windows",
                  "eligibility",
                  "parameters",
                  "refresh"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^user\\.[a-z0-9_.-]+$",
                    "maxLength": 80
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "category": {
                    "enum": [
                      "身体",
                      "训练",
                      "营养",
                      "阶段",
                      "发现"
                    ]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "operator": {
                    "enum": [
                      "series",
                      "rolling_mean",
                      "calendar",
                      "distribution",
                      "exercise_progress",
                      "interval_compare",
                      "phase_compare",
                      "training_weight",
                      "intake_summary",
                      "nutrition_history",
                      "phase_summary",
                      "scene_compare"
                    ]
                  },
                  "metric": {
                    "enum": [
                      "weight",
                      "body_fat",
                      "waist",
                      "height"
                    ]
                  },
                  "windows": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "accumulated",
                        "current_phase",
                        "7d",
                        "28d",
                        "90d"
                      ]
                    }
                  },
                  "eligibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "minPoints",
                      "minDays"
                    ],
                    "properties": {
                      "minPoints": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "minDays": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 3650
                      },
                      "minPerGroup": {
                        "type": "integer",
                        "minimum": 3,
                        "maximum": 1000
                      },
                      "minEffect": {
                        "type": "number",
